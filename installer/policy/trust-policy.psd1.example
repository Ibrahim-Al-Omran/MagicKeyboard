    AllowedReleaseSignerCertificateSha256 = @()
    AllowedPayloadSignerCertificateSha256 = @()
    AllowedDriverSignerCertificateSha256 = @()

    RequireTimestamp = $true
    MinimumReleaseSequence = 1
}
